/* image-cropper.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md, 16px);
  padding: var(--spacing-md, 16px);
  background-color: #f5f5f5;
}

.cropper-container {
  position: relative;
  overflow: hidden;
}

.cropper-canvas {
  width: 100%;
  height: auto;
}

.control-panel {
  display: flex;
  gap: var(--spacing-sm, 8px);
  flex-wrap: wrap;
}

button {
  background-color: var(--primary-color, #07c160);
  color: white;
  border: none;
  padding: var(--spacing-xs, 4px) var(--spacing-sm, 8px);
  border-radius: var(--border-radius, 4px);
}

button[disabled] {
  background-color: #cccccc;
  cursor: not-allowed;
}

.loading, .progress {
  text-align: center;
  color: #666;
}